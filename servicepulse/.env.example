# ServicePulse Configuration
# Copy this file to .env and adjust values

# Application
APP_ENV=development
APP_NAME=ServicePulse
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./servicepulse.db

# Failure Simulation (development only)
# Both conditions required: APP_ENV=development AND FAILURE_SIMULATION_ENABLED=true
FAILURE_SIMULATION_ENABLED=false
